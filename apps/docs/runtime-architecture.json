  "cards": [
    {
      "dot": "cyan",
      "title": "Primary request path",
      "items": [
        "Vue pages call a constrained preload API.",
        "Electron owns the desktop lifecycle and starts the local Python service.",
        "Python routes dispatch into Star Manager domain services."
      ]
    },
    {
      "dot": "violet",
      "title": "Persistence and work",
      "items": [
        "SQLite stores searchable indexes and cached metadata.",
        "Single-object mutations use direct HTTP routes; batch mutations use /tasks.",
        "Task progress is polled and reflected back into the renderer."
      ]
    },
    {
      "dot": "amber",
      "title": "External machine state",
      "items": [
        "HS2 UserData, mods, and abdata remain user-selected filesystem state.",
        "BepInEx probe access is optional and game-side.",
        "Resource tooling is invoked for specialized export and repair flows."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "The renderer is separated from privileged filesystem and process access.",
        "Preload is the narrow crossing into Electron capabilities.",
        "Game files and helper tools are outside the core app control plane."
      ]
    }
  ]
