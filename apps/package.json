{
  "name": "star-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + Vue + Python desktop app for Star_Manager.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && set ELECTRON_RUN_AS_NODE=&& set ELECTRON_RENDERER_URL=http://127.0.0.1:5173&& electron .\"",
    "build": "vite build",
    "build:backend": "node scripts/python.cjs pyinstaller",
    "package:win": "npm run build && npm run build:backend && electron-builder --win dir --config.electronDist=node_modules/electron/dist",
    "preview": "vite preview --host 127.0.0.1",
    "electron": "npm run build && set ELECTRON_RUN_AS_NODE=&& electron .",
    "python:dev": "node scripts/python.cjs dev",
    "check:python": "node scripts/python.cjs check",
    "check:package-deps": "node scripts/python.cjs check-package-deps"
  },
  "build": {
    "appId": "com.lunaburg.star-manager",
    "productName": "Star_Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build-resources/**/*",
      "backend/app/**/*",
      "backend/star_manager/**/*",
      "backend/.vendor/**/*",
      "backend/requirements.txt",
      "!backend/**/__pycache__/**/*",
      "!backend/**/*.pyc",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend/star_manager_backend.exe",
        "to": "backend/star_manager_backend.exe"
      }
    ],
    "win": {
      "icon": "build-resources/app-icon.ico",
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "three": "^0.178.0",
    "vite": "^6.3.5",
    "vue": "^3.5.16"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.3"
  }
}
