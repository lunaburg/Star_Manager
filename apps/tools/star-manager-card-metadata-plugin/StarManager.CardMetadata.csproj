<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>StarManager.CardMetadata</AssemblyName>
    <RootNamespace>StarManager.CardMetadata</RootNamespace>
    <Version>1.4.2</Version>
    <AssemblyVersion>1.4.2.0</AssemblyVersion>
    <FileVersion>1.4.2.0</FileVersion>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\test\hs2</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="validation\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HS2API">
      <HintPath>$(GameDir)\BepInEx\Plugins\HS2API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HS2_ExtensibleSaveFormat">
      <HintPath>$(GameDir)\BepInEx\Plugins\HS2_BepisPlugins\HS2_ExtensibleSaveFormat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\HoneySelect2_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\HoneySelect2_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\HoneySelect2_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(GameDir)\BepInEx\Plugins\HS2API.dll')"
      Text="HS2API.dll was not found. Build with /p:GameDir=D:\path\to\HoneySelect2." />
    <Error
      Condition="!Exists('$(GameDir)\BepInEx\Plugins\HS2_BepisPlugins\HS2_ExtensibleSaveFormat.dll')"
      Text="HS2_ExtensibleSaveFormat.dll was not found under the selected GameDir." />
  </Target>
</Project>
